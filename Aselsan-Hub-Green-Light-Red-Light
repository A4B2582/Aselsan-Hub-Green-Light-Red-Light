-- Özel ve Ayrıştırılmış Takım Değiştirme Fonksiyonu
local function forceJoinTeam(roleName)
	pcall(function()
		local searchPattern = string.lower(roleName)

		-- 1. Yöntem: İstemci Üzerinden Doğrudan Takım Eşleşmesi
		local targetTeam = nil
		for _, team in ipairs(Teams:GetTeams()) do
			local tName = string.lower(team.Name)
			if string.find(tName, searchPattern) then
				targetTeam = team
				break
			end
		end

		if targetTeam then
			player.Team = targetTeam
		end

		-- 2. Yöntem: ReplicatedStorage Üzerindeki Spesifik Remote Event Kontrolü
		for _, item in ipairs(ReplicatedStorage:GetDescendants()) do
			if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
				local itemName = string.lower(item.Name)
				
				-- Sadece seçilen role tam uyan veya genel takım remote'larını tetikle
				if string.find(itemName, searchPattern) 
					or string.find(itemName, "team") 
					or string.find(itemName, "role") 
					or string.find(itemName, "select") then
					
					-- Karşı tarafın yanlış takıma atmasını engellemek için sadece tam rol adını gönder
					if item:IsA("RemoteEvent") then
						item:FireServer(roleName)
					elseif item:IsA("RemoteFunction") then
						item:InvokeServer(roleName)
					end
				end
			end
		end
	end)
end

