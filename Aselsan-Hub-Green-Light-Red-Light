	btnCorner.Parent = tabBtn

	return tabBtn
end

local mainTabBtn = createTabButton("Main", 1)
local teamTabBtn = createTabButton("Takım", 2)

local tabs = {
	{Btn = mainTabBtn, Frame = mainTabFrame},
	{Btn = teamTabBtn, Frame = teamTabFrame}
}

local function switchTab(selectedTab)
	for _, tab in ipairs(tabs) do
		if tab == selectedTab then
			tab.Frame.Visible = true
			tab.Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
			tab.Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			tab.Frame.Visible = false
			tab.Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
			tab.Btn.TextColor3 = Color3.fromRGB(180, 180, 180)
		end
	end
end

switchTab(tabs[1])

mainTabBtn.MouseButton1Click:Connect(function()
	switchTab(tabs[1])
end)

teamTabBtn.MouseButton1Click:Connect(function()
	switchTab(tabs[2])
end)

