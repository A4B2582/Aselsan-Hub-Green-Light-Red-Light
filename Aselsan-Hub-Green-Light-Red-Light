		local tickVal = tick() * 2
		local hue = tickVal % 5 / 5
		local currentRgb = Color3.fromHSV(hue, 1, 1)

		outerGradient.Rotation = (tick() * 50) % 360

		for _, obj in ipairs(rgbTextParts) do
			if obj and obj.Parent then
				if obj:IsA("TextButton") or obj:IsA("TextLabel") then
					obj.TextColor3 = currentRgb
				end
			end
		end
	end)
end)

